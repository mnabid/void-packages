# Template file for 'antigravity-ide'
pkgname=antigravity-ide
version=2.5.5
revision=1
_buildver=4923483625488384
archs="x86_64 aarch64"
create_wrksrc=yes
short_desc="Agentic development platform from Google"
maintainer="Nafis <mnabid.25@outlook.com>"
license="custom:LicenseRef-Google-Antigravity"
homepage="https://antigravity.google/"
repository=nonfree
restricted=yes
noshlibprovides=yes
nostrip=yes

_src="https://dl.google.com/release2/j0qc3/antigravity/stable"
case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="${_src}/${version}-${_buildver}/linux-x64/Antigravity%20IDE.tar.gz>${pkgname}-${version}_amd64.tar.gz"
	checksum=0c5233b297d2b3aebb61af49f8944012c2953d361a5ebb16978490636917f831
	;;
aarch64)
	distfiles="${_src}/${version}-${_buildver}/linux-arm/Antigravity%20IDE.tar.gz>${pkgname}-${version}_arm64.tar.gz"
	checksum=88c167108980c33a223a8d7f0aa6aaf4dec61f0cc3950235a2698e9ffc38a49e
	;;
*)
	broken="No distfiles available for this target"
	;;
esac


do_install() {
	vmkdir opt
	vcopy "Antigravity IDE" opt/antigravity-ide
	vbin "${FILESDIR}/antigravity-ide.sh" antigravity-ide

	vinstall "${FILESDIR}/antigravity-ide.desktop" 644 usr/share/applications
	vinstall "${FILESDIR}/antigravity-ide-url-handler.desktop" 644 usr/share/applications
	vinstall "${FILESDIR}/antigravity-ide.appdata.xml" 644 usr/share/metainfo
	vinstall "${FILESDIR}/antigravity-ide-workspace.xml" 644 usr/share/mime/packages

	vinstall "Antigravity IDE/resources/app/resources/linux/code.png" 644 usr/share/pixmaps antigravity-ide.png
	vinstall "Antigravity IDE/resources/completions/bash/antigravity-ide" 644 usr/share/bash-completion/completions
	vinstall "Antigravity IDE/resources/completions/zsh/_antigravity-ide" 644 usr/share/zsh/site-functions
	rm -r "${DESTDIR}/opt/antigravity-ide/resources/completions"

	vlicense "${DESTDIR}/opt/antigravity-ide/LICENSES.chromium.html"
	vlicense "${DESTDIR}/opt/antigravity-ide/resources/app/LICENSE.txt"
}
