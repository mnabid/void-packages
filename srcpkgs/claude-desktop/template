# Template file for 'claude-desktop'
pkgname=claude-desktop
version=2.26454.0
revision=1
archs="x86_64 aarch64"
create_wrksrc=yes
depends="hicolor-icon-theme libpipewire socat xdg-desktop-portal xdg-utils
 $(vopt_if sandbox 'bubblewrap edk2-ovmf virtiofsd')"
short_desc="Desktop application for Claude.ai"
maintainer="Nafis <mnabid.25@outlook.com>"
license="custom:Proprietary"
homepage="https://claude.com/download"
repository=nonfree
restricted=yes
nostrip=yes

build_options="sandbox"
desc_option_sandbox="Enable Cowork sandbox support"

case "$XBPS_TARGET_MACHINE" in
x86_64)
	depends+=" $(vopt_if sandbox qemu-system-amd64)"
	distfiles="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_${version}_amd64.deb"
	checksum=6d3e4973dcb11511ddd962040b3073b435d1592b3174a82ef52e50377a75a63f
	;;
aarch64)
	depends+=" $(vopt_if sandbox qemu-system-aarch64)"
	distfiles="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_${version}_arm64.deb"
	checksum=01bdff873d3ce37b4dcc56cd2dfbc4711b9c8f9abce479e75a52f946a083d981
	;;
*)
	broken="No distfiles available for this target"
	;;
esac

do_install() {
	vcopy usr .

	# Replace upstream's binary script with our own
	rm ${DESTDIR}/usr/bin/claude-desktop
	vbin ${FILESDIR}/claude-desktop.sh claude-desktop

	# Fix permissions for SUID sandbox
	chmod 4755 ${DESTDIR}/usr/lib/claude-desktop/chrome-sandbox

	# Remove debian specific lintian file
	rm -r ${DESTDIR}/usr/share/lintian

	if [ "$build_option_sandbox" ]; then
		# Cowork compatibility shims
		# Void ships virtiofsd in /usr/libexec
		ln -s ../libexec/virtiofsd ${DESTDIR}/usr/bin/virtiofsd

		# EDK2 firmware paths
		if [ "$XBPS_TARGET_MACHINE" = "x86_64" ]; then
			vmkdir usr/share/edk2
			ln -s x64/OVMF_CODE.4m.fd ${DESTDIR}/usr/share/edk2/OVMF_CODE_4M.fd
			ln -s x64/OVMF_VARS.4m.fd ${DESTDIR}/usr/share/edk2/OVMF_VARS_4M.fd
		fi
	fi

	vlicense usr/share/doc/claude-desktop/copyright
}
