site="https://github.com/EliverLara/Andromeda-gtk/commits/main.atom
https://github.com/EliverLara/Andromeda-gtk/commits/standard-buttons.atom"
pattern='[\d.]+'

curl() {
	if [[ "$*" == *"/commits/"* ]]; then
		command curl "$@" | grep -m1 -Po '<updated>\K[0-9]{4}-[0-9]{2}-[0-9]{2}' | tr -d '-' | sed 's/^/0.0./'
	else
		command curl "$@"
	fi
}
