# Template file for 'wps-office-cn'
pkgname=wps-office-cn
version=12.1.2.28080
revision=1
_buildver=765474
archs="x86_64"
hostmakedepends="python3"
short_desc="WPS Office productivity suite - Chinese version"
maintainer="Nafis <mnabid.25@outlook.com>"
license="custom:EULA"
homepage="https://linux.wps.cn"
changelog="https://linux.wps.cn/wpslinuxlog"
conflicts="wps-office>=0"
provides="wps-office-${version}_${revision}"
allow_unknown_shlibs=yes
nodebug=yes
nostrip=yes
noshlibprovides=yes
restricted=yes
repository=nonfree
python_version=3

# The download URL requires a time-based HMAC signature
_fname="wps-office_${version}.AK.preread.sw.Personal_${_buildver}_amd64.deb"
_url="https://wps-linux-personal.wpscdn.cn/wps/download/ep/Linux2023/${version##*.}/${_fname}"
_key='7f8faaaa468174dc1c9cd62e5f218a5b'
_ts=$(date '+%s')
_hash=$(printf '%s' "${_key}${_url#*wpscdn.cn}${_ts}" | md5sum | cut -d' ' -f1)

distfiles="${_url}?t=${_ts}&k=${_hash}>wps-office_${version}_amd64.deb"
checksum=2fa999f60a71e21093ab49ef6d7f61d7668c844bfebf30907d2c290e460f9be0

do_install() {
	# Install main tree preserving structure
	cp -a * ${DESTDIR}

	# Remove bundled libraries to use system ones
	for _lib in libstdc++ libjpeg libcurl libdbus-1 libgcc_s; do
		rm ${DESTDIR}/opt/kingsoft/wps-office/office6/${_lib}.so*
	done
	rm ${DESTDIR}/opt/kingsoft/wps-office/office6/addons/cef/libz.so*

	# Provide symlinks to missing libraries
	ln -s /usr/lib/libbz2.so.1.0 ${DESTDIR}/opt/kingsoft/wps-office/office6/libbz2.so.1.0
	ln -s /usr/lib/libelogind.so.0 ${DESTDIR}/opt/kingsoft/wps-office/office6/libsystemd.so.0

	# Rename commands to avoid conflicts (e.g. et -> wpset)
	for _bin in et misc wpp; do
		mv ${DESTDIR}/usr/bin/${_bin} ${DESTDIR}/usr/bin/wps${_bin}
	done
	for _bin in et wpp; do
		vsed -i ${DESTDIR}/usr/share/applications/wps-office-${_bin}.desktop \
			-e "/^Exec=/ s/\(${_bin}\)/wps\1/"
	done

	# Disable cloud service background processe
	chmod -x ${DESTDIR}/opt/kingsoft/wps-office/office6/wpscloudsvr

	# Replace custom "WPS Office" menu with generic "Office" category
	rm -r ${DESTDIR}/etc/xdg/menus
	vsed -i ${DESTDIR}/usr/share/applications/wps-office-*.desktop \
		-e "s/^\(Categories=\)/\1Office;/"

	# Rename 2023 icons to 2019, for compatibility with most icon themes
	find ${DESTDIR}/usr/share/icons -type f -name "*2023*" -exec rename '2023' '2019' {} +
	vsed -i ${DESTDIR}/usr/share/applications/wps-office-*.desktop \
		-e "/^\(Icon=\)/ s/2023/2019/"

	# Install license and documentation
	vlicense opt/kingsoft/wps-office/office6/mui/default/EULA_linux.html
	vdoc opt/kingsoft/wps-office/office6/mui/default/Privacy_Linux.html
}

wps-office-mui-zh-cn_package() {
	short_desc="Chinese (Simplified) MUI package for WPS Office"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove opt/kingsoft/wps-office/office6/mui/en_US/resource/help
		vmove opt/kingsoft/wps-office/office6/mui/zh_CN
		vlicense opt/kingsoft/wps-office/office6/mui/default/EULA_linux.html
	}
}

wps-office-mime-cn_package() {
	short_desc="MIME files provided by WPS Office"
	depends="shared-mime-info"
	conflicts="wps-office-mime>=0"
	provides="wps-office-mime-${version}_${revision}"
	pkg_install() {
		vmove usr/share/mime
		vlicense opt/kingsoft/wps-office/office6/mui/default/EULA_linux.html
	}
}
