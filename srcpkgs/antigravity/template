# Template file for 'antigravity'
pkgname=antigravity
version=2.10.0
revision=1
_buildver=4996573600546816
archs="x86_64 aarch64"
create_wrksrc=yes
short_desc="Multi-agent orchestration platform"
maintainer="Nafis <mnabid.25@outlook.com>"
license="custom:LicenseRef-Google-Antigravity"
homepage="https://antigravity.google/product/antigravity-2"
repository=nonfree
restricted=yes
noshlibprovides=yes
nostrip=yes

_repo="https://storage.googleapis.com/antigravity-public/antigravity-hub"
case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="${_repo}/${version}-${_buildver}/linux-x64/Antigravity.tar.gz>${pkgname}-${version}_amd64.tar.gz"
	checksum=d0a67abaedf7368f9f226ea25d7e3e69a9a989a774ef0f925926a359ce94b084
	;;
aarch64)
	distfiles="${_repo}/${version}-${_buildver}/linux-arm/Antigravity.tar.gz>${pkgname}-${version}_arm64.tar.gz"
	checksum=86c0f26f10f14ff57bf1cf03dd481d5ba12c9f2cbc120b1209833554901cf0fa
	;;
*)
	broken="No distfiles available for this target"
	;;
esac


do_install() {
	vmkdir opt
	vcopy "Antigravity-*" opt/antigravity
	vbin "${FILESDIR}/antigravity.sh" antigravity

	vinstall "${FILESDIR}/antigravity.desktop" 644 usr/share/applications
	vinstall "${FILESDIR}/antigravity.png" 644 usr/share/pixmaps

	vlicense "${DESTDIR}/opt/antigravity/LICENSES.chromium.html"
	vlicense "${DESTDIR}/opt/antigravity/LICENSE.electron.txt"
}
