site="https://github.com/uutils/diffutils/commits/main.atom"
pattern='[\d.]+'

curl() {
	if [[ "$*" == *"/commits/"* ]]; then
		local line latest_tag commit_date url count=0
		url="${@: -1}"

		# Get latest tag
		while read -r line; do
			if [[ "$line" =~ \<title\>v?([0-9.]+)\<\/title\> ]]; then
				latest_tag="${BASH_REMATCH[1]}"
				break
			fi
		done < <(command curl "${@:1:$#-1}" "${url%/commits/*}/tags.atom")

		# Get latest commit date
		while read -r line; do
			if [[ "$line" =~ \<updated\>([0-9]{4})-([0-9]{2})-([0-9]{2}) ]]; then
				((count++))
				if [[ "$count" -eq 2 ]]; then
					commit_date="${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]}"
					break
				fi
			fi
		done < <(command curl "$@")

		echo "$latest_tag"
		echo "${latest_tag}.${commit_date}"
	else
		command curl "$@"
	fi
}
