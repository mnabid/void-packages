# Template file for 'uutils-findutils'
pkgname=uutils-findutils
version=0.10.0
revision=1
build_style=cargo
build_helper="rust"
make_check_args="-- --skip get_or_create_file_test"
hostmakedepends="pkg-config"
makedepends="oniguruma-devel rust-std"
short_desc="Rust implementation of GNU findutils"
maintainer="Nafis <mnabid.25@outlook.com>"
license="MIT"
homepage="https://github.com/uutils/findutils"
distfiles="https://github.com/uutils/findutils/archive/refs/tags/${version}.tar.gz"
checksum=e36ae3937f889bc59cfbd65820a642baa695c58d7fa1e387e41857e710f40419

alternatives="
 find:find:/usr/bin/ufind
 xargs:xargs:/usr/bin/uxargs
"

if [ "$CROSS_BUILD" ]; then
	hostmakedepends+=" oniguruma-devel"
fi

if [ "$XBPS_TARGET_LIBC" = musl ]; then
	make_check_args+=" --skip newer_time_matcher"
fi

post_install() {
	for _f in find locate updatedb xargs; do
		mv "${DESTDIR}/usr/bin/${_f}" "${DESTDIR}/usr/bin/u${_f}"
	done
	rm ${DESTDIR}/usr/bin/testing-commandline
	vlicense LICENSE
}
