# Template file for 'zotero'
pkgname=zotero
version=10.0.1
revision=1
archs="x86_64 i686 aarch64"
short_desc="Your personal research assistant"
maintainer="Nafis <mnabid.25@outlook.com>"
license="AGPL-3.0-or-later"
homepage="https://www.zotero.org"
changelog="https://www.zotero.org/support/changelog"

case "$XBPS_TARGET_MACHINE" in
	x86_64)
		distfiles="https://download.zotero.org/client/release/${version}/Zotero-${version}_linux-x86_64.tar.xz"
		checksum=7bf57ab1e757077f2168a58cbc20b7f6db516ae7ad787bca94c6cdf0df6df200
		;;
	i686)
		distfiles="https://download.zotero.org/client/release/${version}/Zotero-${version}_linux-i686.tar.xz"
		checksum=0ca1ed6776204c0cbd2eb450ee41e146986e9487fce7dbd83f34efe8311be2c5
		;;
	aarch64)
		distfiles="https://download.zotero.org/client/release/${version}/Zotero-${version}_linux-arm64.tar.xz"
		checksum=e42e69275dafa14af0342f5dea24242a3f7c39ba7e92b4ee00a97b0f08cd387a
		;;
	*)
		broken="No distfiles available for this target"
		;;
esac

# Archive doesn't provide a license file
distfiles+=" https://raw.githubusercontent.com/zotero/zotero/master/COPYING"
checksum+=" 5b7dc919393650eef5f37b25cc399717159a7df5cdec98fa26c846346389bce6"
skip_extraction="COPYING"

do_install() {
	vmkdir usr/bin
	vmkdir usr/lib/zotero
	vcopy "*" usr/lib/zotero
	ln -sf /usr/lib/zotero/zotero ${DESTDIR}/usr/bin/zotero

	# No need to keep a shell around when launching Zotero
	vsed -i 's/^\("\$CALLDIR\/zotero-bin" -app "\$CALLDIR\/app\/application.ini" "\$@"\)/exec \1/' \
		${DESTDIR}/usr/lib/zotero/zotero

	# Enable global menu support
	vmkdir usr/lib/zotero/app/defaults/preferences
	{
		echo 'pref("widget.gtk.global-menu.enabled", true);'
		echo 'pref("widget.gtk.global-menu.wayland.enabled", true);'
	} > ${DESTDIR}/usr/lib/zotero/app/defaults/preferences/global-menu.js

	# Install desktop file
	vinstall ${FILESDIR}/zotero.desktop 644 usr/share/applications

	# Install icons
	for size in 32 64 128; do
		vmkdir usr/share/icons/hicolor/${size}x${size}/apps
		vinstall icons/icon${size}.png 644 usr/share/icons/hicolor/${size}x${size}/apps zotero.png
	done
	vmkdir usr/share/icons/hicolor/symbolic/apps
	vinstall icons/symbolic.svg 644 usr/share/icons/hicolor/symbolic/apps zotero-symbolic.svg

	# Install license
	vlicense ${XBPS_SRCDISTDIR}/${pkgname}-${version}/COPYING
}
