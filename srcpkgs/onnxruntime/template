# Template file for 'onnxruntime'
pkgname=onnxruntime
version=1.28.0
revision=1
build_style=cmake
build_wrksrc=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release
 -Donnxruntime_BUILD_SHARED_LIB=ON
 -Donnxruntime_ENABLE_PYTHON=ON
 -DBUILD_ONNX_PYTHON=ON
 -Donnxruntime_BUILD_UNIT_TESTS=OFF
 -DBUILD_TESTING=OFF
 -DFETCHCONTENT_FULLY_DISCONNECTED=OFF"
hostmakedepends="cmake ninja python3 python3-setuptools python3-wheel python3-numpy pkg-config flatbuffers"
makedepends="python3-devel protobuf-devel re2-devel flatbuffers-devel eigen boost-devel zlib-devel abseil-cpp-devel json-c++"
short_desc="Cross-platform, high performance ML inferencing engine"
maintainer="Nafis <mnabid.25@outlook.com>"
license="MIT"
homepage="https://onnxruntime.ai/"
distfiles="https://github.com/microsoft/onnxruntime/archive/refs/tags/v${version}.tar.gz"
checksum=9616cbdbbfcb1420b3261cd280a047d74ab0a249825e577b0e2dd310e22f6b83

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	makedepends+=" libexecinfo-devel"
fi

do_build() {
	cmake --build build ${makejobs}
	cd build
	python3 ../setup.py build
}

do_install() {
	DESTDIR="$DESTDIR" cmake --install build
	cd build
	python3 ../setup.py install --skip-build --root="$DESTDIR"

	cd "$DESTDIR"/usr/lib/python3*/site-packages/onnxruntime/capi
	ln -sfv ../../../../libonnxruntime_providers_shared.so ../../../../libonnxruntime.so.* .
	vlicense ../LICENSE
}

onnxruntime-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/share/cmake
	}
}

python3-onnxruntime_package() {
	depends="python3-numpy python3-packaging python3-protobuf python3-sympy"
	short_desc+=" - Python bindings"
	pkg_install() {
		vmove usr/lib/python3*
	}
}
